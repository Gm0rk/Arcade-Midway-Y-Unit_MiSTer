function automatic [30:0] fm_rec(input [5:0] id);
	case (id)
		6'h00: fm_rec = {1'b1, 1'b0, 3'd0, 9'd0, 9'd70, 8'd0};   // Johnny Cage: Decapitation
		6'h01: fm_rec = {1'b1, 1'b1, 3'd0, 9'd0, 9'd80, 8'd8};   // Johnny Cage: The Pit
		6'h08: fm_rec = {1'b1, 1'b0, 3'd1, 9'd0, 9'd102, 8'd15};   // Kano: Heart Rip
		6'h09: fm_rec = {1'b1, 1'b1, 3'd1, 9'd0, 9'd80, 8'd23};   // Kano: The Pit
		6'h10: fm_rec = {1'b1, 1'b0, 3'd5, 9'd0, 9'd99, 8'd30};   // Sub-Zero: Spine Rip
		6'h11: fm_rec = {1'b1, 1'b1, 3'd5, 9'd0, 9'd80, 8'd38};   // Sub-Zero: The Pit
		6'h18: fm_rec = {1'b1, 1'b0, 3'd6, 9'd0, 9'd511, 8'd45};   // Sonya: Kiss of Death
		6'h19: fm_rec = {1'b1, 1'b1, 3'd6, 9'd0, 9'd80, 8'd54};   // Sonya: The Pit
		6'h20: fm_rec = {1'b1, 1'b0, 3'd2, 9'd74, 9'd134, 8'd61};   // Raiden: Electrocution
		6'h21: fm_rec = {1'b1, 1'b1, 3'd2, 9'd0, 9'd80, 8'd70};   // Raiden: The Pit
		6'h28: fm_rec = {1'b1, 1'b0, 3'd3, 9'd0, 9'd511, 8'd77};   // Liu Kang: Cartwheel
		6'h29: fm_rec = {1'b1, 1'b1, 3'd3, 9'd0, 9'd80, 8'd86};   // Liu Kang: The Pit
		6'h30: fm_rec = {1'b1, 1'b0, 3'd4, 9'd119, 9'd158, 8'd93};   // Scorpion: Fire Breath
		6'h31: fm_rec = {1'b1, 1'b1, 3'd4, 9'd0, 9'd80, 8'd99};   // Scorpion: The Pit
		default: fm_rec = 31'd0;
	endcase
endfunction


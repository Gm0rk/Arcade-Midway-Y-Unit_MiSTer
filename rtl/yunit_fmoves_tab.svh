function automatic [29:0] fm_rec(input [5:0] id);
	case (id)
		6'h00: fm_rec = {1'b1, 3'd0, 9'd0, 9'd70, 8'd0};   // Johnny Cage: Decapitation
		6'h08: fm_rec = {1'b1, 3'd1, 9'd0, 9'd102, 8'd8};   // Kano: Heart Rip
		6'h10: fm_rec = {1'b1, 3'd5, 9'd0, 9'd99, 8'd16};   // Sub-Zero: Spine Rip
		6'h18: fm_rec = {1'b1, 3'd6, 9'd0, 9'd511, 8'd24};   // Sonya: Kiss of Death
		6'h20: fm_rec = {1'b1, 3'd2, 9'd74, 9'd134, 8'd33};   // Raiden: Electrocution
		6'h28: fm_rec = {1'b1, 3'd3, 9'd0, 9'd511, 8'd42};   // Liu Kang: Cartwheel
		6'h30: fm_rec = {1'b1, 3'd4, 9'd119, 9'd158, 8'd51};   // Scorpion: Fire Breath
		default: fm_rec = 30'd0;
	endcase
endfunction


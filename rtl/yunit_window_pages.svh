// fighter: the Move List option's order (0 Johnny Cage ... 6 Scorpion)
function automatic [2:0] win_page(input [2:0] fighter);
	case (fighter)
		3'd0: win_page = 3'd0;    // Johnny Cage
		3'd1: win_page = 3'd0;    // Kano
		3'd2: win_page = 3'd0;    // Sub-Zero
		3'd3: win_page = 3'd0;    // Sonya
		3'd4: win_page = 3'd1;    // Raiden
		3'd5: win_page = 3'd1;    // Liu Kang
		3'd6: win_page = 3'd1;    // Scorpion
		default: win_page = 3'd0;
	endcase
endfunction
